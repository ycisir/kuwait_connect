# ==========================================
# Python & Django Core
# ==========================================
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Django local settings & logs
local_settings.py
*.log

# Django media and collected static files
# (Keep static_src/assets tracked, but ignore generated/uploaded files)
media/
staticfiles/

# ==========================================
# Databases & Environments
# ==========================================
# Local SQLite database
db.sqlite3
*.sqlite3

# Environment variables containing secrets/API keys
.env
.flaskenv

# Virtual environments
venv/
.venv/
env/
ENV/
env.bak/

# ==========================================
# IDEs, Editors & OS Specific
# ==========================================
# VS Code
.vscode/

# PyCharm / IntelliJ
.idea/

# Operating System files
.DS_Store
Thumbs.db
